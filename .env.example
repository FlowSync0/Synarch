SYNARCH_ENV=local
SYNARCH_LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synarch
POSTGRES_USER=synarch
POSTGRES_PASSWORD=synarch
DATABASE_URL=postgresql+psycopg://synarch:synarch@localhost:5432/synarch

REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

GATEWAY_URL=http://localhost:8000
CONTROL_PLANE_URL=http://localhost:8010
STATE_SERVICE_URL=http://localhost:8020
MEMORY_SERVICE_URL=http://localhost:8030
EVENT_SERVICE_URL=http://localhost:8040
AGENT_RUNTIME_URL=http://localhost:8050

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Never commit real provider API keys.

# Local SecretVault encryption. Fill only in your local .env before storing production connector
# credentials. Any non-empty passphrase is accepted; a Fernet key is also accepted.
SECRET_VAULT_KEY=
# Prefer SECRET_VAULT_KEY_FILE on servers/Docker when the key is mounted as a secret file.
# The local compose stack mounts synarch_secret_keys at /run/secrets/synarch.
# Example: /run/secrets/synarch/secret-vault.key
SECRET_VAULT_KEY_FILE=
# Set to true in production-like environments so Gateway refuses to store new connector secrets
# unless SECRET_VAULT_KEY or SECRET_VAULT_KEY_FILE is configured and local vault entries are encrypted.
SECRET_VAULT_REQUIRE_ENCRYPTION=false

# Backend runtime mode:
# - stub: deterministic local fake runtime, no external model call
# - openrouter: real OpenRouter call from agent-runtime
AGENT_RUNTIME_MODE=stub

# OpenRouter real-call settings. Fill only in your local .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash
OPENROUTER_MAX_OUTPUT_TOKENS=1800
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_REASONING_EXCLUDE=true
OPENROUTER_INPUT_COST_PER_MILLION_TOKENS=0
OPENROUTER_OUTPUT_COST_PER_MILLION_TOKENS=0

# Optional web extraction providers.
WEB_EXTRACT_DEFAULT_PROVIDER=local_fetch
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=30
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io
BROWSERLESS_TIMEOUT_SECONDS=30
WEB_EXTRACT_PLAYWRIGHT_TIMEOUT_SECONDS=30
WEB_EXTRACT_PLAYWRIGHT_WAIT_UNTIL=domcontentloaded
WEB_EXTRACT_REVIEW_EVIDENCE_MAX_BYTES=4096
BROWSERBASE_API_KEY=
BROWSERLESS_API_KEY=
BRIGHTDATA_API_KEY=

# Gateway task-runner model accounting.
AGENT_RUNTIME_TIMEOUT_SECONDS=180
TASK_LEASE_SECONDS=300
TASK_RETRY_BACKOFF_SECONDS=60
TASK_RUNNER_PROVIDER_ID=provider-local-runtime-stub
TASK_RUNNER_MODEL_ID=model-local-runtime-stub
TASK_RUNNER_INPUT_COST_PER_MILLION_TOKENS=0
TASK_RUNNER_OUTPUT_COST_PER_MILLION_TOKENS=0
TASK_RUNNER_EMBEDDING_PROVIDER_ID=
TASK_RUNNER_EMBEDDING_MODEL_ID=
TASK_RUNNER_EMBEDDING_TIMEOUT_SECONDS=20

# Scheduler worker. It only runs when explicitly started.
SYNARCH_SCHEDULER_WORKER_ID=scheduler-worker-local
SYNARCH_SCHEDULER_MAX_TASKS=3
SYNARCH_SCHEDULER_INTERVAL_SECONDS=30
SYNARCH_SCHEDULER_TIMEOUT_SECONDS=180
